{
  "name": "traefikcop",
  "version": "0.5.0",
  "private": true,
  "description": "Web application editor and health checks for remote Docker Traefik hosts",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "test:browser": "node scripts/editor-browser-check.mjs",
    "test:traffic-browser": "node scripts/traffic-browser-check.mjs",
    "test:onboarding": "node scripts/onboarding-check.mjs",
    "test:clipboard-browser": "node scripts/clipboard-browser-check.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
